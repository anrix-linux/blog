---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'figure'> {
  src?: ImageMetadata;
  alt?: string;
  /** Text on the chin of the photo. */
  caption?: string;
  /** Intrinsic width (px) of the optimized image. */
  width?: number;
  loading?: 'eager' | 'lazy';
  /** CSS `object-position` for the crop, e.g. `50% 10%` to keep a face near the top. */
  position?: string;
}

const {
  src,
  alt = '',
  caption,
  width = 768,
  loading = 'lazy',
  position = '50% 40%',
  class: className,
  ...rest
} = Astro.props;

const frameClasses = [
  'relative',
  'm-0',
  'aspect-[8847/10752]',
  'rotate-2',
  'border-2',
  'border-ink',
  'bg-bg-elevated',
  'shadow-[6px_6px_0_0_var(--ink)]',
];

const photoWindowClasses = [
  'absolute',
  'top-[5.6%]',
  'left-[5.4%]',
  'aspect-[7894/7680]',
  'w-[89.2%]',
  'border-2',
  'border-ink',
  'overflow-hidden',
];
---

<figure class:list={[frameClasses, className]} {...rest}>
  <span
    class:list={[
      'absolute',
      '-top-3',
      'left-1/2',
      'h-6',
      'w-20',
      '-translate-x-1/2',
      'border-2',
      'border-ink',
      'bg-accent',
    ]}
    aria-hidden="true"
  ></span>

  {src ? (
    <Image
      {src}
      {alt}
      {width}
      {loading}
      class:list={[photoWindowClasses, 'object-cover']}
      style={`object-position: ${position}`}
    />
  ) : (
    <div class:list={[photoWindowClasses, 'flex items-center justify-center bg-bg p-3']}>
      <slot />
    </div>
  )}

  {caption && (
    <figcaption
      class:list={[
        'absolute',
        'inset-x-0',
        'bottom-0',
        'flex',
        'h-[23.7%]',
        'items-center',
        'justify-center',
        'text-center',
        'font-heading',
        'text-[1.25rem]',
        'leading-none',
        'font-bold',
        'text-ink',
      ]}
    >
      {caption}
    </figcaption>
  )}
</figure>
