---
import { AUTHOR_NAME, SOURCE_URL } from '@/lib/site';

const fullYear = new Date().getFullYear();
---

<footer
  class:list={[
    'flex',
    'flex-wrap',
    'items-center',
    'justify-center',
    'gap-x-3',
    'gap-y-2',
    'border-t-4',
    'border-ink',
    'px-5',
    'py-7',
    'text-center',
    'font-heading',
    'text-[0.95rem]',
    'font-semibold',
    'text-ink',
  ]}
>
  <span>
    &copy; {fullYear} {AUTHOR_NAME} &middot;
    <a
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
      target="_blank"
      rel="noopener noreferrer"
      class="underline underline-offset-4"
    >
      CC BY-NC-SA 4.0
    </a>
    &middot;
    <a href={SOURCE_URL} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">
      Source (AGPL-3.0)
    </a>
  </span>
</footer>
